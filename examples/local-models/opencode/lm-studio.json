{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/__LM_STUDIO_MODEL_ID__",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": { "baseURL": "http://127.0.0.1:1234/v1" },
      "models": { "__LM_STUDIO_MODEL_ID__": { "name": "LM Studio local model" } }
    }
  },
  "mcp": {
    "multi-agent-memory": {
      "type": "local",
      "command": ["__NODE_EXECUTABLE__", "__SERVER_ENTRYPOINT__"],
      "environment": { "MULTI_AGENT_MEMORY_DB": "__MEMORY_DB__" },
      "enabled": true,
      "timeout": 10000
    }
  }
}
