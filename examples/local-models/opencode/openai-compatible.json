{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/__MODEL_ID__",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local OpenAI-compatible server",
      "options": { "baseURL": "http://127.0.0.1:8000/v1" },
      "models": { "__MODEL_ID__": { "name": "Local model" } }
    }
  },
  "mcp": {
    "multi-agent-memory": {
      "type": "local",
      "command": ["__NODE_EXECUTABLE__", "__SERVER_ENTRYPOINT__"],
      "environment": { "MULTI_AGENT_MEMORY_DB": "__MEMORY_DB__" },
      "enabled": true,
      "timeout": 10000
    }
  }
}
