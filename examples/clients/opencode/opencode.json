{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "multi-agent-memory": {
      "type": "local",
      "command": ["__NODE_EXECUTABLE__", "__SERVER_ENTRYPOINT__"],
      "environment": {
        "MULTI_AGENT_MEMORY_DB": "__MEMORY_DB__"
      },
      "enabled": true,
      "timeout": 10000
    }
  }
}
